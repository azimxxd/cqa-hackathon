PORT=3000
# Organizers' API: paste the DEV GET link here without the group_id value
ORG_API_URL=
DEFAULT_GROUP_ID=DEV

# LLM provider: gemini | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# USD per 1M tokens, used for the cost shown in the UI
PRICE_INPUT_PER_M=0.30
PRICE_OUTPUT_PER_M=2.50

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

LLM_CONCURRENCY=6
