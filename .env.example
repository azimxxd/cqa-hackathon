PORT=3000
# Organizers' API: paste the DEV GET link here without the group_id value
ORG_API_URL=
DEFAULT_GROUP_ID=DEV

# LLM provider: gemini | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional comma-separated pool; keys may share a project quota
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.1-flash-lite
# USD per 1M tokens, used for the cost shown in the UI
PRICE_INPUT_PER_M=0.25
PRICE_OUTPUT_PER_M=1.50

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

LLM_CONCURRENCY=6

# Gemini audio transcription (uses GEMINI_API_KEY or GEMINI_API_KEYS)
GEMINI_TRANSCRIBE_MODEL=gemini-3.1-flash-lite
